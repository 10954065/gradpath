# GradPath environment variables
# Copy to `.env.local` for local development. Never commit real values.

# --- Public (browser) values -------------------------------------------------
# Only the Supabase project URL and the *anon/publishable* key may be exposed to
# the browser. Row Level Security protects every private table.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: public site URL used to build auth redirect links (defaults to window.location.origin)
VITE_SITE_URL=

# --- Server-side only (Netlify Functions) ------------------------------------
# The shipped Netlify Functions reuse the public URL/anon key together with the
# caller's JWT, so no privileged key is required. If you add a function that
# needs elevated access, set SUPABASE_SERVICE_ROLE_KEY in the Netlify UI only
# (never in a VITE_ variable and never in git).
# SUPABASE_SERVICE_ROLE_KEY=
